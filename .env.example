# LLM API Keys (Required for Stage 1 synthetic generation and Stage 3 extraction)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
# Primary: Groq LLaMA model
PRIMARY_MODEL=groq/llama-3.3-70b-versatile
# Fallback: Google Gemini free tier
FALLBACK_MODEL=gemini/gemini-1.5-flash

# Execution Settings
MAX_CONCURRENT_REQUESTS=3
RANDOM_SEED=42
